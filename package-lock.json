{
  "name": "nemoris",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "nemoris",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.6.3"
      }
    },
    "apps/capsule": {
      "name": "@capsule/app",
      "version": "0.1.0",
      "dependencies": {
        "@capsule/core": "0.1.0",
        "@capsule/ui": "0.1.0"
      }
    },
    "apps/capsule-api": {
      "name": "@capsule/api",
      "version": "0.1.0",
      "dependencies": {
        "@capsule/core": "0.1.0",
        "@capsule/export": "0.1.0",
        "@capsule/observability": "0.1.0"
      }
    },
    "node_modules/@capsule/api": {
      "resolved": "apps/capsule-api",
      "link": true
    },
    "node_modules/@capsule/app": {
      "resolved": "apps/capsule",
      "link": true
    },
    "node_modules/@capsule/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@capsule/export": {
      "resolved": "packages/export",
      "link": true
    },
    "node_modules/@capsule/observability": {
      "resolved": "packages/observability",
      "link": true
    },
    "node_modules/@capsule/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/core": {
      "name": "@capsule/core",
      "version": "0.1.0"
    },
    "packages/export": {
      "name": "@capsule/export",
      "version": "0.1.0"
    },
    "packages/observability": {
      "name": "@capsule/observability",
      "version": "0.1.0"
    },
    "packages/ui": {
      "name": "@capsule/ui",
      "version": "0.1.0"
    }
  }
}
